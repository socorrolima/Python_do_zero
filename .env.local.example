# Copie este arquivo para .env.local e preencha com os valores do seu projeto Supabase.
# NUNCA versione .env.local nem coloque chaves diretamente no código (item 30 do prompt mestre).

# Painel do Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de uso exclusivamente no servidor (Route Handlers / área administrativa futura).
# Nunca expor com o prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
